<!DOCTYPE html>
<html lang="pl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>DCHLK GARAGE — Konfigurator</title>

    <style>
        body {
            margin: 0;
            min-height: 100vh;
            background: #111;
            color: white;
            font-family: Arial, sans-serif;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .container {
            width: 90%;
            max-width: 700px;
            text-align: center;
        }

        h1 {
            font-size: 42px;
            letter-spacing: 4px;
            margin-bottom: 10px;
        }

        p {
            color: #aaa;
        }

        .products {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 15px;
            margin-top: 35px;
        }

        button {
            padding: 25px 15px;
            border: 1px solid #444;
            background: #1b1b1b;
            color: white;
            font-size: 18px;
            cursor: pointer;
            border-radius: 8px;
        }

        button:hover {
            border-color: #8b1e2d;
            background: #222;
        }

        #selected {
            margin-top: 30px;
            font-size: 18px;
            color: #ddd;
        }
    </style>
</head>

<body>

<div class="container">

    <h1>DCHLK GARAGE</h1>

    <p>YOUR CAR. YOUR STYLE.</p>

    <h2>Co chcesz zamówić?</h2>

    <div class="products">
        <button onclick="selectProduct('Koszulka')">KOSZULKA</button>
        <button onclick="selectProduct('Bluza')">BLUZA</button>
        <button onclick="selectProduct('Kubek')">KUBEK</button>
        <button onclick="selectProduct('Brelok')">BRELOK</button>
    </div>

    <div id="selected">
        Wybierz produkt.
    </div>

</div>

<script>

function selectProduct(product) {
    document.getElementById("selected").innerHTML =
        "Wybrano: <strong>" + product + "</strong>";
}

</script>

</body>
</html>
